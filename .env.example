# =============================================================================
# AI Hub - Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI Hub"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# AI Providers
# ---------------------------------------------------------------------------
# Google Gemini
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Microsoft Copilot
COPILOT_API_KEY=your-copilot-api-key

# Groq
GROQ_API_KEY=your-groq-api-key

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key

# Default AI Provider (gemini | claude | openai | copilot | groq | mistral)
AI_DEFAULT_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Rate Limiting (Upstash Redis) - optional
# When not configured, rate limiting is disabled (app works without it).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
