    "ai": "^4.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.x",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.0",
