    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.x",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "supabase": "^1.200.0",
